{
  "name": "locale-simple",
  "version": "0.0.21",
  "description": "Translation system based on gettext, same API in Perl, Python and JavaScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Getty/locale-simple.git"
  },
  "keywords": [
    "gettext",
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation"
  ],
  "author": "Torsten Raudssus <torsten@raudssus.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Getty/locale-simple/issues"
  },
  "homepage": "https://github.com/Getty/locale-simple#readme",
  "devDependencies": {
    "rollup": "^4.0.0"
  }
}
