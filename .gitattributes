# export-ignore acts on `git archive`, not only on Composer: it also shapes the
# GitHub "Source code" downloads and the zip the Go module proxy builds
# (cmd/go: `git archive --format=zip`). Never ignore go/, go.mod, php/,
# composer.json or rust/ here: the proxy caches a module version for good.
#
# Check after every change:
#   git archive --format=zip HEAD | zipinfo -1 -
# go.mod, go/*, composer.json, php/* must be listed, lib/ and t/ must not.
lib/ export-ignore
t/ export-ignore
python/ export-ignore
js/ export-ignore
xbin/ export-ignore
bin/ export-ignore
dist.ini export-ignore
cpanfile export-ignore
